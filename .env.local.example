# URL of the Pi backend (Flask server exposed publicly)
# Example: https://pi.yourdomain.ts.net  or  http://YOUR_PUBLIC_IP:5001
NEXT_PUBLIC_TAMAGOTCHI_API=http://localhost:5001

# Vercel Postgres (filled automatically by `vercel env pull` once the store is linked)
POSTGRES_URL=

# Server only: token that can create releases/assets on GITHUB_REPO (recording uploads)
GITHUB_TOKEN=
GITHUB_REPO=HermannPR/MildredPierce
